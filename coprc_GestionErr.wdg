  procedures :
   -
     name : pglb_HandleError
     procedure_id : 1922217084408706930
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure pglb_HandleError(sRet est une chaîne, bToast est un booléen = Faux)
      coulToast est une Couleur
      
      // modifier pour géré les avertissement
      SI sRet <> "OK" _ET_ PAS sRet [=  "OK" ALORS
      	SI bToast ALORS
      		SELON sRet
      			CAS [= "ERROR"
      				coulToast = RougePastel
      
      			CAS [= "AVERT", [= "INFO"
      				coulToast = VertPastel
      
      			CAS [= "VIDE"
      				coulToast = JaunePastel
      
      		FIN
      
      		ToastAffiche(ExtraitChaîne(sRet, 2, ";"),toastCourt,cvMilieu,chCentre, coulToast)
      	SINON
      		SELON sRet
      			CAS [= "ERROR"
      				Erreur(ExtraitChaîne(sRet, 2, ";"))
      
      			CAS [= "AVERT",[= "VIDE", [= "INFO"
      				Info(ExtraitChaîne(sRet, 2, ";"))
      
      			CAS [= "OK"
      				Info(ExtraitChaîne(sRet, 2, ";"))
      		FIN
      	FIN
      	SI sRet [= "OK" ALORS
      		RENVOYER Vrai
      	FIN
      	RENVOYER Faux
      FIN
      
      RENVOYER Vrai
     type : 458752
