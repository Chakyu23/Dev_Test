 message_bar :
  internal_properties : IQAAACAAAACVj5ddYvJ30qjdpzs5eNUAsqSCm9SI5d2xI+tTSrbtbUIPdl3QmSH7bsUtsGeDNzY/j1/RIRi/hnefp117YOqtQvkagyVUvACg5hD5u3kOtf4EiB3s1juUxbsOdbBOPETQdA==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      //--- Fenêtre Popup ---
      PROCEDURE MaFenêtre(gtabJetons est un tableau associatif de jeton, gChampSaisie est un champ)
      
      // Présentation des choix inutile s'il n'y a aucun choix
      si gtabJetons..Vide Ferme
      
      // Initialise la zone répétée à partir des jetons
      ZoneRépétéeSupprimeTout(ZR_Sélection)
      pour tout jeton de gtabJetons
      	// Ajoute la ligne dans la zone répétée
      	ZoneRépétéeAjouteLigne(ZR_Sélection, jeton.Valeur, jeton.Extra.lib, 1, faux)
      	pour toute unJetonSélectionné de gChampSaisie.Jeton
      		si unJetonSélectionné.Valeur = jeton.Valeur ALORS
      			ZR_Sélection[ZR_Sélection.Occurrence].ATT_Sélection	= Vrai
      			ZR_Sélection[ZR_Sélection.Occurrence].ATT_VAL		= unJetonSélectionné.Extra.Val
      		FIN
      	FIN
      FIN
   -
     code : |1+
      
      
     type : 34
   -
     code : |1+
      
      
     type : 234
   -
     code : |1+
      
      
     type : 165
   -
     code : |1+
      
      
     type : 177
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      // Construit la nouvelle valeur
      monJeton est un jeton
      gChampSaisie.SupprimeToutJeton()
      POUR i = 1 _À_ ZR_Sélection..Occurrence
      	SI ZR_Sélection[i].ATT_Sélection alors
      		monJeton.Libellé	= ZR_Sélection[i].ATT_Option + " " + ZR_Sélection[i].ATT_VAL
      		monJeton.Valeur		= ZR_Sélection[i].ATT_ID
      		monJeton.Extra.Val	= ZR_Sélection[i].ATT_VAL
      		monJeton.Extra.Lib	= ZR_Sélection[i].ATT_Option
      
      		gChampSaisie.AjouteJeton(monJeton)
      	FIN
      FIN
     type : 2
