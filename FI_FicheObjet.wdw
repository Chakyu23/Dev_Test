                  	vf_nLigneSurvol									= 0
                  FIN
                 type : 153
               -
                 type : 222
                 enabled : false
               -
                 type : 223
                 enabled : false
               -
                 type : 224
                 enabled : false
               -
                 code : |1+
                  
                  nLigne est un entier
                  
                  nLigne = TableInfoXY(Tbl_CaractObj,tiNumLigne,SourisPosX(), SourisPosY())
                  
                  SI vf_nLigneSurvol <> nLigne ALORS
                  	SI vf_nLigneSurvol > 0 _ET_ vf_nLigneSurvol <= Tbl_CaractObj..Occurrence ALORS
                  		OBMc_Action[vf_nLigneSurvol].BTN_Suppr..Visible = Faux
                  	FIN
                  	SI nLigne > 0 _ET_ nLigne <= Tbl_CaractObj..Occurrence ALORS
                  		OBMc_Action[nLigne].BTN_Suppr..Visible = Vrai
                  	FIN
                  
                  	vf_nLigneSurvol = nLigne
                  FIN
                 type : 66048
