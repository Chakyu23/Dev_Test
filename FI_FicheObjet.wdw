     -
       name : IMG_OBJ_SEL
       identifier : 0x2aad11b0203f610a
       internal_properties : 
       properties :
        width : 202
        height : 202
        plane : 1
        anchor_ratio_size_x : 0
        data_binding : Objet_Model.Img
        tab_stop : 0
        take_focus : 0
       type : 8
       code_elements :
        type_code : 8
        p_codes :
         -
           code : |1-
            
           type : 18
         -
           code : |1+
            sFichier est une chaîne
            
            // Ouvre le sélecteur d'images
            sFichier = fSélecteurImage("", "", "Sélectionnez une image...")
            SI sFichier = "" ALORS retour
            
            IMG_OBJ_SEL = dChargeImage(sFichier, imgDéfaut, 200, 200)
            
            sFichier = fRepTemp() + [fSep()] + DateVersChaîne(DateHeureSys(), "DD-MM-JJ_HH-MM-SS") +".png"
            si pas dSauveImagePNG(IMG_OBJ_SEL,  sFichier) ALORS
            	ToastAffiche("Échec du chargement de l'image",toastCourt,cvBas,chCentre, rougepastel)
            FIN
           type : 31
         -
           code : |1-
            
           type : 17
     -
       name : SAI_MotClef
       identifier : 0x2aad11ca2043c4b5
       internal_properties : 
       properties :
        x : 5
        y : 413
        width : 595
        height : 118
        state : 1
        caption :
         fr-FR : Key Words
        plane : 1
        anchor : 1
        anchor_ratio_size_x : 0
        accelerator_key : 65535
        tab_order : 7
       type : 2
       code_elements :
        type_code : 3
        p_codes :
         -
           code : |1-
            // Version 1
            // Description
            // Multi sélection avec des jetons
            
            global
            // Personnalisez ici les valeurs possibles pour la multi sélection
            gtabJetons est un tableau associatif de jetons
            local
            
            POUR TOUT KeyWord
            	unJeton est un jeton
            	unJeton.Libellé 	= KeyWord.Name + " 1"
            	unJeton.valeur 		= KeyWord.IDKeyWord
            	unJeton.Extra.Lib	= KeyWord.Name
            	unJeton.Extra.Val	= 1
            	gtabJetons[KeyWord.IDKeyWord] = unJeton
            FIN
           type : 14
         -
           code : |1-
            PROCEDURE AjoutJeton (MonJeton est un Jeton)
            
            //RENVOYER Faux pour interdire l'ajout du jeton
            RENVOYER faux
           type : 276
         -
           code : |1-
            PROCEDURE SuppressionJeton (MonJeton est un Jeton)
            
            //RENVOYER Faux pour interdire la suppression du jeton
            RENVOYER Vrai
           type : 277
         -
           code : |1+
            PROCEDURE ClicJeton (MonJeton est un Jeton)
           type : 278
         -
           code : |1+
            PROCÉDURE EntreSaisieJeton (MonJeton est un Jeton)
            
            //RENVOYER Faux pour interdire l'entrée en saisie du jeton
            RENVOYER Faux
           type : 338
         -
           code : |1+
            PROCÉDURE ModificationJeton (MonJeton est un Jeton)
            
            // RENVOYER Faux pour interdire la modification du jeton
            RENVOYER faux
           type : 339
         -
           code : |1-
            sRet est une chaîne
            
            // Ouvre la popup avec les choix possibles
            OuvrePopupPosition(FEN_Sel_KeyWord, popEnDessous, gtabJetons, MonChamp)
            
            sRet = cKeyWord.Sauve_Jeton(SAI_MotClef..Nom, vf_nID)
            SI PAS pglb_handleError(sRet) ALORS RETOUR
           type : 66050
