  procedures :
   -
     name : prc_ChargeFiche
     procedure_id : 1922217410829508424
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      
      procédure prc_ChargeFiche()
      sRet est une chaîne
      
      SI vf_bModel = vrai ALORS
      	SI PAS HLitRecherche(Objet_Model, IDObjet_Model, vf_nID, hIdentique) ALORS
      		Erreur("Le modèle d'objet n'existe pas")
      		ExécuteTraitement(FI_FicheObjet.BTN_Retour, trtClic)
      		retour
      	fin
      FIN
      
      FichierVersEcran()
      
      prc_QualDesig
      
      sRet = cKeyWord.Affiche_Jeton(SAI_MotClef, vf_nID)
      SI PAS pglb_HandleError(sRet) ALORS
      	ExécuteTraitement(FI_FicheObjet.BTN_Retour, trtClic)
      	RETOUR
      FIN
     type : 458752
   -
     name : prc_QualDesig
     procedure_id : 1922222745219716144
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure prc_QualDesig()
      
      LIB_QMax = cQuality.GetDesig(SAI_QMax)
      LIB_QMin = cQuality.GetDesig(SAI_QMin)
     type : 458752
   -
     name : prc_OBMC_Saisie
     procedure_id : 1922224750975611414
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure prc_OBMC_Saisie()
      nLigne est un entier
      
      nLigne = TableSelect(Tbl_CaractObj)
      SI nLigne = -1 ALORS RETOUR
      
      SI OBMC_TAG[nLigne] = 0 ALORS
      	GR_OBMC_SAISIE..Etat = AffichageSeulement
      SINON
      	GR_OBMC_SAISIE..Etat = Actif
      FIN
      
     type : 458752
   -
     name : prc_SupprTBL
     procedure_id : 1922230278622549327
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sNomTBL (chaîne ANSI)  <indiquez ici le rôle de sNomTBL>
      //!
      //!
      
      procédure prc_SupprTBL(sNomTBL est une chaîne)
      nInd est un entier
      
      nInd = TableSelect(sNomTBL)
      SI nInd <> -1 ALORS
      	TableSupprime(sNomTBL, nInd)
      FIN
     type : 458752
