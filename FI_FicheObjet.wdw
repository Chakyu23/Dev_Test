      -
        code : |1-
         PROCEDURE FI_FicheObjet(vf_sClef est une chaîne)
         vf_nID			est une chaîne
         vf_bModel		est un booléen
         vf_nLigneSurvol	est un entier
         
         (vf_bModel, vf_nID) = ChaîneDécoupe(vf_sClef, "|")
         
         si vf_bModel = Vrai ALORS
         	MaFenêtreInterne..Plan = 1
         sinon
         	MaFenêtreInterne..Plan = 2
         FIN
         
         
         HTransactionDébut()
         
         prc_ChargeFiche()
      -
        code : |1-
         
        type : 14
      -
        code : |1+
         
         
        type : 234
      -
        code : |1+
         
         
        type : 43
      -
