                   -
                     code : |1-
                      nLigne est un entier
                      
                      nLigne = TableSelect(Tbl_CaractObj)
                      SI nLigne = -1 ALORS RETOUR
                      
                      POUR i=1 _À_ Tbl_CaractObj..Occurrence
                      	SI nLigne = i ALORS CONTINUER
                      	SI COL_Tag[i] = MoiMême..ValeurAffichée ALORS
                      		ToastAffiche("Cette caractéristique existe déjà")
                      		MoiMême = 0
                      		SORTIR
                      	FIN
                      FIN
                      
