              code : |1-
               // Version 1
               // Description
               // Multi sélection avec des jetons
               
               global
               // Personnalisez ici les valeurs possibles pour la multi sélection
               gtabJetons est un tableau associatif de jetons
               local
               
               POUR TOUT KeyWord
               	unJeton est un jeton
               	unJeton.Libellé 	= KeyWord.Name + " 1"
               	unJeton.valeur 		= KeyWord.IDKeyWord
               	unJeton.Extra.Lib	= KeyWord.Name
               	unJeton.Extra.Val	= 1
               	gtabJetons[KeyWord.IDKeyWord] = unJeton
               FIN
              type : 14
            -
              code : |1-
               PROCEDURE AjoutJeton (MonJeton est un Jeton)
               
               //RENVOYER Faux pour interdire l'ajout du jeton
               RENVOYER faux
