           take_focus : 0
          type : 8
          code_elements :
           type_code : 8
           p_codes :
            -
              code : |1-
               
              type : 18
            -
              code : |1+
               sFichier est une chaîne
               nLigne est un entier
               
               nLigne = TableSelect(TBL_ObjetModel)
               SI nLigne = -1 ALORS RETOUR
               // Ouvre le sélecteur d'images
               sFichier = fSélecteurImage("", "", "Sélectionnez une image...")
               SI sFichier = "" ALORS retour
               
               IMG_OBJ_SEL = dChargeImage(sFichier, imgDéfaut, 200, 200)
               
               sFichier = fRepTemp() + [fSep()] + DateVersChaîne(DateHeureSys(), "DD-MM-JJ_HH-MM-SS") +".png"
               si dSauveImagePNG(IMG_OBJ_SEL,  sFichier) ALORS
               	HAttacheMémo(Objet_Model, Img, sFichier, hMémoImg)
               	HModifie(Objet_Model)
               	fSupprime(sFichier)
               FIN
              type : 31
            -
              code : |1-
               
              type : 17
