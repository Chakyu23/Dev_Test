               nLigne est un entier
               
               nLigne = TableSelect(TBL_ObjetModel)
               SI nLigne = -1 ALORS RETOUR
               
               // Ouvre la popup avec les choix possibles
               OuvrePopupPosition(FEN_Sel_KeyWord, popEnDessous, gtabJetons, MonChamp)
               
               prc_Enreg_KeyWord(OBM_IDObm[nLigne])
