  procedures :
   -
     name : prc_OBMC_Saisie
     procedure_id : 1916710859075185884
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // prc_OBMC_Saisie ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure prc_OBMC_Saisie()
      nLigne est un entier
      
      nLigne = TableSelect(Tbl_CaractObj)
      SI nLigne = -1 ALORS RETOUR
      
      si OBMC_TAG[nLigne] = 0 ALORS
      	GR_OBMC_SAISIE..Etat = AffichageSeulement
      sinon
      	GR_OBMC_SAISIE..Etat = Actif
      FIN
     type : 458752
   -
     name : prc_SelLigneOBM
     procedure_id : 1918165143579988619
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure prc_SelLigneOBM()
      nLigne		est un entier
      sFichier	est une chaîne
      
      nLigne = TableSelect(TBL_ObjetModel)
      SI nLigne = -1 ALORS RETOUR
      
      IMG_OBJ_SEL = ""
      SI Objet_Model.Img <> "" ALORS
      	sFichier	= fRepTemp() + [fSep()] + DateVersChaîne(DateHeureSys(), "DD-MM-JJ_HH-MM-SS") +".png"
      	SI HExtraitMémo(Objet_Model, Img, sFichier) ALORS
      		IMG_OBJ_SEL	= dChargeImage(sFichier, imgDéfaut, 200, 200)
      		fSupprime(sFichier)
      	FIN
      FIN
      
      Tbl_CaractObj.prc_SelObjm(OBM_IDObm[nLigne])
      
      req_KW_ObjMod est une Requête SQL =
      `
      	SELECT KeyWord.Name, KeyWord_Objet_Model.IDKeyWord, KeyWord_Objet_Model.Value<§cs:3§>
      	FROM KeyWord_Objet_Model<§cs:3§>
      	INNER JOIN KeyWord ON KeyWord.IDKeyWord = KeyWord_Objet_Model.IDKeyWord<§cs:3§>
      	WHERE KeyWord_Objet_Model.IDObjet_Model = {pp_nID}<§cs:3§>
      `
      
      SaisieSupprimeToutJeton(SAI_MotClef)
      
      req_KW_ObjMod.pp_nID = OBM_IDObm[nLigne]
      SI PAS HExécuteRequête(req_KW_ObjMod, hRequêteDéfaut) ALORS
      	RETOUR
      FIN
      POUR TOUT req_KW_ObjMod
      	unJeton est un Jeton
      	unJeton.Libellé					= req_KW_ObjMod.Name + " " + req_KW_ObjMod.VALUE
      	unJeton.Valeur					= req_KW_ObjMod.IDKeyWord
      	unJeton.Extra.Lib				= req_KW_ObjMod.Name
      	unJeton.Extra.Val				= req_KW_ObjMod.VALUE
      
      	SaisieAjouteJeton(SAI_MotClef, unJeton)
      FIN
      HLibèreRequête(req_KW_ObjMod)
     type : 458752
   -
     name : prc_Enreg_KeyWord
     procedure_id : 1918165371213702023
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param nID (entier)  <indiquez ici le rôle de nID>
      //!
      //!
      
      procédure prc_Enreg_KeyWord(LOCAL nID est un entier)
      
      Req_DeleteKeyWordObj	est une requête SQL =
      `
      	DELETE From KeyWord_Objet_Model WHERe KeyWord_Objet_Model.IDObjet_Model = {pp_Id}<§cs:3§>
      `
      
      Req_DeleteKeyWordObj.pp_Id = nID
      si pas HExécuteRequête(Req_DeleteKeyWordObj) ALORS
      	retour
      FIN
      
      pour TOUT unJeton de SAI_MotClef..Jeton
      	hraz(KeyWord_Objet_Model)
      	KeyWord_Objet_Model.IDKeyWord		= unJeton.Valeur
      	KeyWord_Objet_Model.IDObjet_Model	= nID
      	KeyWord_Objet_Model.Value			= unJeton.Extra.Val
      	HAjoute(KeyWord_Objet_Model)
      FIN
     type : 458752
  procedure_templates : []
  property_templates : []
