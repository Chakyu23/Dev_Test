        -
          name : IMG_OBJ_SEL
          identifier : 0x2a9951a7157881b6
          internal_properties : 
          properties :
           x : 8
           y : 323
           width : 202
           height : 202
           anchor : 1
           anchor_ratio_size_x : 0
